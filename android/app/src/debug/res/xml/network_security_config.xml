<?xml version="1.0" encoding="utf-8"?>
<!--
  v40 yalnız hata ayıklama derlemesi: emülatördeki (10.0.2.2) ve yerel ağdaki (192.168.x.x) geliştirme sunucusuna
  düz HTTP ile bağlanılır. Yayın derlemesinin kuralları src/main/res/xml/network_security_config.xml'de.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
