<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v33 bağlantı izleme: bağlantı gelince bekleyen sunucu işleri yapılır -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v40 yerel bildirimler (güncelleme, hatırlatma); Android 13+ çalışma zamanında, önce uygulama içi açıklamayla istenir -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Paylaşım hedeflerinin (WhatsApp, Instagram, Pinterest) yüklü olup olmadığını görebilmek için -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.instagram.android" />
        <package android:name="com.pinterest" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:name=".DrawGuidanceApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrawGuidance"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true">
        <!-- v40 yedekleme: Firebase oturumu, sunucu adresi ve tanılama kayıtları yedeğe girmez (xml/backup_rules,
             xml/data_extraction_rules). Düz HTTP yalnız hata ayıklama derlemesinde (xml/network_security_config). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DrawGuidance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v39 AdMob uygulama kimliği (derleme türüne göre: hata ayıklamada Google'ın deneme kimliği) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Kaydedilen resimleri diğer uygulamalarla güvenle paylaşmak için (file:// yerine content://) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
