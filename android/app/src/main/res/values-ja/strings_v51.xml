<?xml version="1.0" encoding="utf-8"?>
<!-- v51 işlev eğitim grupları, yeni alıştırma türleri, puan parçaları ve ödüllü reklam -->
<resources>
    <string name="tut51_draw">描画ツールと保存</string>
    <string name="tut51_draw_text">ブラシ、塗りつぶし、消しゴム、ペン、元に戻す、レイヤー、背景、保存。</string>
    <string name="tut51_edit">追加・選択・編集</string>
    <string name="tut51_edit_text">図形や文字を追加し、選択・移動・拡大縮小・コピー・編集。モードメニュー。</string>
    <string name="tut51_guides">定規と図形テンプレート</string>
    <string name="tut51_guides_text">定規を回転・サイズ変更し、種類・単位・縮尺を選び、縁に沿って、またテンプレートで描きます。</string>
    <string name="tut51_notes_write">文字・ペン・ページ</string>
    <string name="tut51_notes_write_text">見出し、ノート用ペン、蛍光ペン、ページスクラバー、ページ設定、PDF。</string>
    <string name="tut51_notes_add">数式・図表・図形</string>
    <string name="tut51_notes_add_text">追加メニュー、数式、図表、矢印と図形、パネル、数式で描く図形と元素の図形。</string>
    <string name="tut51_select_guides">選択・移動・定規</string>
    <string name="tut51_select_guides_text">モードメニュー、プロパティ、移動と拡張、長押しで移動、定規で描画。</string>
    <string name="tut51_comic_pages">コマ・テンプレート・ページ</string>
    <string name="tut51_comic_pages_text">コマのテンプレート、インクペン、スピード線、表紙、ページ番号、PDF と CBZ。</string>
    <string name="tut51_comic_cast">キャラクター・背景・吹き出し・効果</string>
    <string name="tut51_comic_cast_text">既製キャラクター、場所の背景、吹き出し、ナレーション枠、効果音の文字。</string>
    <string name="tut51_simple_draw">描画と塗り</string>
    <string name="tut51_simple_draw_text">ブラシ、図形、塗り、プロパティ。上部メニューの2つの部分。</string>
    <string name="tut51_simple_edit">選択・文字・背景</string>
    <string name="tut51_simple_edit_text">3つのメニュー、選択と移動、矩形選択、テキストボックス、スポイト、背景、保存。</string>
    <string name="tut51_simple_guides">定規・テンプレート・画像から描く</string>
    <string name="tut51_simple_guides_text">定規と図形テンプレート。画像をベクター化してテンプレートにし、それで描きます。</string>
    <string name="tut51_kids_more">定規・テンプレート・チャレンジ</string>
    <string name="tut51_kids_more_text">マスコットが定規、絵の移動、お絵かきチャレンジ、テンプレートで描く方法を見せます。</string>
    <string name="v51_practice_kind_copy">見て描く</string>
    <string name="v51_practice_intro_copy">隅の見本を見ながら点線の枠に描きましょう。位置や大きさは自由、比率が大切です。</string>
    <string name="v51_practice_kind_timed">時間制限</string>
    <string name="v51_practice_intro_timed">時間切れになる前にガイドをなぞりましょう。最初の線でタイマーが始まり、早く終えるとスピード点がもらえます。</string>
    <string name="v51_practice_group_observe">観察スケッチ</string>
    <string name="v51_practice_group_figures">人物と肖像</string>
    <string name="v51_practice_time_up">時間切れ</string>
    <string name="v51_practice_points">点</string>
    <string name="v51_practice_record">新記録！</string>
    <string name="v51_practice_accuracy">正確さ</string>
    <string name="v51_practice_coverage">網羅度</string>
    <string name="v51_practice_smoothness">なめらかさ</string>
    <string name="v51_practice_speed">スピード</string>
    <string name="v51_practice_reward_title">広告で解放</string>
    <string name="v51_practice_reward_body">短いリワード広告を見ると、この練習がずっと使えるようになります。プレミアム会員はすべての練習が使えます。</string>
    <string name="v51_practice_reward_failed">今は広告を読み込めませんでした。接続を確認して、少ししてからもう一度お試しください。</string>
    <string name="v51_practice_reward_watch">広告を見る</string>
    <string name="v51_practice_reward_later">あとで</string>
    <string name="v51_practice_reward_badge">広告で解放</string>
