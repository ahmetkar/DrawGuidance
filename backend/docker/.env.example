# DrawGuidance Docker ayarları (v33). Bu dosyayı ".env" adıyla kopyalayıp parolaları değiştirin.
MONGO_ROOT_USER=dgadmin
MONGO_ROOT_PASSWORD=degistir-yonetici-parolasi
MONGO_APP_DB=drawguidance
MONGO_APP_USER=drawguidance
MONGO_APP_PASSWORD=degistir-uygulama-parolasi
# Bilgisayardaki kapılar (yerel ağdaki telefon API'ye http://<bilgisayarın IP'si>:4747 ile bağlanır)
API_PORT=4747
MONGO_PORT=27017
# MongoDB önbelleği (GB)
MONGO_CACHE_GB=1
# Üç üyeli kopya kümesi için: RS_MEMBERS=mongo1:27017,mongo2:27017,mongo3:27017 ve --profile rs3
RS_MEMBERS=mongo1:27017
# Yazma onayı: majority (kalıcı) ya da w1 (hızlı)
MONGO_WRITE_CONCERN=majority
# Firebase proje kimliği (ID jetonlarının aud değeri; iss = https://securetoken.google.com/<proje>)
FIREBASE_PROJECT_ID=drawguidance
# v40 web sitesi: CORS'a izinli kökenler (virgülle). Üretim sitesi ve yerel geliştirme
WEB_ALLOWED_ORIGINS=https://drawguidance.ahmetkar.com,http://localhost:3000
# İsteğe bağlı köken kalıpları (virgülle), ör. Vercel önizlemeleri: https://drawguidance-*.vercel.app
WEB_ALLOWED_ORIGIN_PATTERNS=
# Sunucu nginx/Caddy gibi bir ters vekilin arkasındaysa true (X-Forwarded-For okunur); değilse false
WEB_BEHIND_PROXY=false
WEB_PROXY_HOPS=1
# IP özeti için uzun rastgele bir yazı (ör. openssl rand -hex 32). Boşsa her açılışta rastgele üretilir
IP_HASH_SALT=
# Slack gelen web kancası (https://hooks.slack.com/services/...). Sırdır; boşsa bildirim gönderilmez
SLACK_WEBHOOK_URL=
