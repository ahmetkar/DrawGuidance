"tut_ai_more_text_v38" = "من القائمة ⋮ تشغّل الذكاء الاصطناعي لهذه اللوحة أو توقفه؛ وتُفعَّل اقتراحات النص والشكل والخطوط كلٌّ على حدة. تعمل الاقتراحات على جهازك وتتكيف معك كلما قبلتها.";
"tut_ai_select" = "اقتراح عند التحديد";
"tut_ai_select_text" = "في وضع التحديد، عند تحديد عدة عناصر يظهر الاقتراح دون الضغط على زر؛ وعند تحديد عنصر أو اثنين تُقترح الأجزاء التي تكمل الرسم. ويفتح الزر «اقتراح تصحيح متعدد» في شريط التحديد الاقتراح نفسه.";
"tut_ai_select_text_v38" = "في وضع التحديد، حدد خطين أو أكثر فتظهر الاقتراحات دون ضغط زر: اقتراحات النص والشكل والخطوط في فقاعات منفصلة. زر اقتراح التصحيح المتعدد في شريط التحديد يفتح الاقتراحات نفسها.";
"tut_art_a1" = "وضع الإضافة";
"tut_art_a1_text" = "الأشكال والنص والخطوط الإرشادية وخطوط المنظور والأشكال ثلاثية الأبعاد والصور كلها في هذه القائمة. يكفي أن تختار عنصرًا ثم تلمس اللوحة أو تسحب عليها.";
"tut_art_a2" = "أشكال جاهزة";
"tut_art_a2_text" = "مئات الأشكال المتجهة: مناظر وحيوانات ومبانٍ وأسهم ورسوم بيانية… يُغيَّر حجمها بالسحب؛ وتقبل تعبئة متدرجة ولون حافة. نضيف الشمس والجبال والغيوم والصنوبر.";
"tut_art_a3" = "النص";
"tut_art_a3_text" = "المس اللوحة واكتب: أكثر من 30 خطًا، غامق ومائل، إطار، ظل، مربع نص. نضع عنوانًا للمنظر.";
"tut_art_a4" = "تحديد";
"tut_art_a4_text" = "المس لتحديد عنصر أو أكثر؛ ثم انسخ أو أخفِ أو احذف. نحدد الشمس.";
"tut_art_a5" = "نقل";
"tut_art_a5_text" = "اسحب التحديد أو حرّكه من 1 إلى 10 بكسل بأزرار الأسهم. ننزل الشمس خلف الجبال.";
"tut_art_a6" = "تعديل";
"tut_art_a6_text" = "دوّر وحجّم واقتصّ وعدّل النقاط المتجهة. نكبّر الشمس الغاربة قليلًا.";
"tut_art_add" = "الأشكال والنص والتعديل";
"tut_art_add_text" = "منظر متجه بالأشكال الجاهزة والنص والتحديد والنقل والتعديل.";
"tut_art_ai" = "اقتراحات الذكاء الاصطناعي";
"tut_art_ai2" = "تصحيح الشكل";
"tut_art_ai2_text" = "ارسم دائرة بيدك ثم ارفع القلم: يتعرف الذكاء الاصطناعي عليها ويقترح شكلها المنتظم. نرسم القمر.";
"tut_art_ai2_text_v38" = "ارسم عدة خطوط وارفع القلم: يصبح كل خط منتظمًا وتتصل الأطراف المتقاربة. لا يُقترح شيء لخط واحد. نرسم القمر بقوسين.";
"tut_art_ai2_v38" = "تصحيح الخطوط";
"tut_art_ai3" = "التعرف على القوالب";
"tut_art_ai3_text" = "يُبحث عمّا ترسمه بعدة خطوط في قاعدة بيانات الأشكال وفي الشبكة العصبية للوضع: منزل، شجرة، وجه… نرسم منزلًا.";
"tut_art_ai3_text_v38" = "الشيء المرسوم بـ 4 خطوط متقاربة أو أكثر يُبحث عنه في قاعدة بيانات الأشكال وفي الشبكة العصبية للوضع: بيت، شجرة، وجه… نرسم بيتًا.";
"tut_art_ai4" = "تصحيح الكل";
"tut_art_ai4_text" = "عند رسم 3 عناصر أو أكثر معًا يظهر الاقتراح تلقائيًا؛ و«تصحيح الكل» يصحّحها جميعًا دفعة واحدة. نرسم أشجار الصنوبر.";
"tut_art_ai4_text_v38" = "كل الخطوط المرسومة معًا تُصحَّح بزر واحد. نرسم أشجار الصنوبر.";
"tut_art_ai_text" = "تصحيح ما ترسمه يدويًا والتعرف على القوالب وتصحيح الكل وإعدادات الذكاء الاصطناعي.";
"tut_art_ai_text_v38" = "تصحيح الخطوط (خطان أو أكثر)، والتعرف على القوالب (4 عناصر متقاربة أو أكثر) وإعدادات الذكاء الاصطناعي.";
"tut_art_b1" = "الفرشاة";
"tut_art_b1_text" = "يُختار من هنا القلم والحبر والماركر والفحم والباستيل والفرشاة الناعمة والملمسات. نبدأ برسم حدود الجبال والتلال بقلم الحبر؛ ويُنحِّف الضغط الخط عند الأطراف.";
"tut_art_b2" = "الخصائص: إعدادات الفرشاة";
"tut_art_b2_text" = "السُّمك والشفافية والتدفق وتصحيح الارتعاش. نلوّن الجبال والتلال طبقة فوق طبقة بماركر عريض شبه شفاف.";
"tut_art_b3" = "علبة الطلاء";
"tut_art_b3_text" = "عند عدم وجود تحديد تلوّن الورقة، وإن كان عنصر محددًا تلوّن داخله؛ بلون ثابت أو بتدرّج. نعطي السماء تدرّج الغروب.";
"tut_art_b4" = "الممحاة";
"tut_art_b4_text" = "تمحو ما رُسم بالفرشاة فقط؛ وتبقى الأشكال والنصوص والصور. نفتح جدولًا ينعطف بين التلال.";
"tut_art_b5" = "أداة القلم";
"tut_art_b5_text" = "بلمسة تضع زاوية وبالسحب تضع منحنى؛ لمسارات متجهة نظيفة. نضيف إلى السماء طيورًا بمنحنيات منتظمة.";
"tut_art_b6" = "التراجع والإعادة";
"tut_art_b6_text" = "يمكن التراجع عن كل خطوة وإعادتها؛ والسحب بثلاثة أصابع يمينًا أو يسارًا يؤدي الغرض نفسه. نتراجع عن آخر طائر ثم نعيده.";
"tut_art_b7" = "الطبقات والعناصر";
"tut_art_b7_text" = "احتفظ بالسماء والجبال والتفاصيل في طبقات منفصلة: أخفِها أو اقفلها أو رتّبها. ومن قائمة العناصر يمكنك العثور على كل جزء وتحديده.";
"tut_art_basics" = "أدوات الرسم";
"tut_art_basics_text" = "منظر غروب بالفرشاة وإعدادات الفرشاة وعلبة الطلاء والممحاة وأداة القلم والتراجع والطبقات.";
"tut_cancel" = "إلغاء التعليم";
"tut_comic_ai" = "القصة المصوّرة بالذكاء الاصطناعي";
"tut_comic_ai1" = "التعرف على الفقاعات";
"tut_comic_ai1_text" = "تتعرف شبكة عصبية خاصة بالقصص المصوّرة على الفقاعة والانفجار وعلامات المشاعر التي ترسمها بيدك. نرسم فقاعة كلام.";
"tut_comic_ai2" = "تعبير الوجه";
"tut_comic_ai2_text" = "تُصحَّح الوجوه الضاحكة والمندهشة والغاضبة بالقالب. نرسم وجهًا ضاحكًا.";
"tut_comic_ai3" = "تصحيح الكل";
"tut_comic_ai3_text" = "عند رسم 3 عناصر أو أكثر معًا يظهر الاقتراح تلقائيًا. نرسم فقاعات.";
"tut_comic_ai3_text_v38" = "نرسم فقاعات: زر واحد يحوّلها كلها إلى دوائر منتظمة.";
"tut_comic_ai_text" = "تعرّف خاص بالقصص المصوّرة: فقاعة الكلام وتعابير الوجه وتصحيح الكل.";
"tut_comic_ai_text_v38" = "تعرّف خاص بالقصص المصورة (فقاعة الكلام، تعابير الوجه) وتصحيح الخطوط معًا.";
"tut_comic_p1" = "قائمة الإضافة";
"tut_comic_p1_text" = "في القصة المصوّرة توجد في هذه القائمة: تخطيط الإطارات وفقاعة الكلام والنص المؤثر وخطوط السرعة.";
"tut_comic_p2" = "القوالب";
"tut_comic_p2_text" = "قوالب صفحات جاهزة بلمسة واحدة: شريطان، رباعي، مانغا، ويبتون… نختار إطارًا علويًا كبيرًا وإطارين صغيرين.";
"tut_comic_p3" = "قلم الحبر";
"tut_comic_p3_text" = "حبر وقلم رفيع الرأس لخطوط القصة المصوّرة؛ يرقّ بالضغط. نرسم بطلنا.";
"tut_comic_p4" = "خطوط السرعة والتركيز";
"tut_comic_p4_text" = "خطوط السرعة والتركيز والانفجار والارتعاش للحركة والإبراز؛ تستقر داخل الإطار المحدد. نضيف خطوط تركيز حول البطل.";
"tut_comic_panels" = "الإطارات والرسم";
"tut_comic_panels_text" = "تخطيط الإطارات وبطل بقلم الحبر وخطوط التركيز.";
"tut_comic_t1" = "فقاعة الكلام";
"tut_comic_t1_text" = "فقاعات بيضاوية وتفكير وصراخ وهمس وسرد؛ وجّه الذيل نحو المتحدث بسحبه. بطلنا يتكلم.";
"tut_comic_t2" = "النص المؤثر";
"tut_comic_t2_text" = "نصوص جاهزة مثل BAM! وPOW! وBOOM! بتدرّج وظل. نضيف مؤثرًا.";
"tut_comic_t3" = "صندوق السرد";
"tut_comic_t3_text" = "صندوق أصفر يصف المشهد؛ وهو بلا ذيل. نبدأ القصة بمقدمة.";
"tut_comic_text" = "الفقاعة والنص المؤثر";
"tut_comic_text_text" = "فقاعة الكلام والنص المؤثر وصندوق السرد.";
"tut_done_badge" = "مكتمل";
"tut_drawing" = "جارٍ الرسم…";
"tut_finish" = "إنهاء التعليم";
"tut_finished" = "اكتمل التعليم: %@";
"tut_hint_all" = "تصحيح الكل: يعود كل رسم إلى شكله المنتظم (بخطوة تراجع واحدة).";
"tut_hint_lines" = "اقتراح الخطوط: اضغط عليه فتُصحَّح كل الخطوط المعنية دفعة واحدة (بخطوة تراجع واحدة).";
"tut_hint_shape" = "فقاعة الاقتراح: عند لمسها يتحول الخط المرتجف إلى شكل مثالي. يمكنك لمسها بنفسك إن شئت.";
"tut_hint_template" = "اقتراح القالب: عند لمسه تحل خطوط منتظمة بالفرشاة نفسها محل الرسم.";
"tut_hint_text" = "اقتراح النص: عند لمسه تتحول كتابتك اليدوية إلى نص منتظم في المكان واللون نفسيهما.";
"tut_kids" = "لنرسم مع لوّون";
"tut_kids_1" = "مرحبًا!";
"tut_kids_1_text" = "أنا لوّون! سأريك أدوات الرسم وسنرسم معًا صورة كبيرة. هل أنت مستعد؟";
"tut_kids_2" = "الفرشاة";
"tut_kids_2_text" = "بالفرشاة ترسم ما تشاء. انظر، أرسم شمسًا ساطعة في السماء!";
"tut_kids_3" = "رسوم جاهزة";
"tut_kids_3_text" = "زر الأشكال يضيف رسومًا جاهزة. سأضع بيتًا وبالونات ملونة.";
"tut_kids_4" = "دلو الطلاء";
"tut_kids_4_text" = "اختر الدلو ثم لونًا والمس داخل الشكل: يُلوَّن المكان الذي تلمسه. سقف أحمر وجدار أصفر!";
"tut_kids_5" = "لوّن الكل";
"tut_kids_5_text" = "أبقِ إصبعك على الشكل ثانيتين: عندما تمتلئ الحلقة يُلوَّن الشكل كله. كل البالونات وردية!";
"tut_kids_6" = "الممحاة";
"tut_kids_6_text" = "الممحاة تمسح الخطوط التي لا تريدها. سأمسح هذه الخربشة.";
"tut_kids_7" = "تراجع";
"tut_kids_7_text" = "حدث خطأ؟ سهم الرجوع يتراجع عن آخر خطوة، وسهم الإعادة يعيدها.";
"tut_kids_8" = "لون الورقة";
"tut_kids_8_text" = "يمكنك تغيير لون الورقة أيضًا. سأجعله أزرق سماويًا!";
"tut_kids_9" = "انتهينا!";
"tut_kids_9_text" = "وأخيرًا عشب أخضر! صورتنا جاهزة. الآن دورك، ارسم أجمل صورة!";
"tut_kids_text" = "لوّون يعرّفك بالأدوات ويرسم معك صورة خطوة بخطوة.";
"tut_lines_v38" = "تصحيح الخطوط";
"tut_menu" = "وضع التعليم";
"tut_next" = "الخطوة التالية";
"tut_notes_ai" = "ملاحظات بالذكاء الاصطناعي";
"tut_notes_ai1" = "تحويل الكتابة اليدوية إلى نص";
"tut_notes_ai1_text" = "اكتب بيدك ثم ارفع القلم: يُتعرَّف عليها بقاموس تركي ونموذج لغوي، وعند اللمس تتحول إلى نص في المكان نفسه. نكتب \"kuvvet\".";
"tut_notes_ai2" = "تصحيح الشكل";
"tut_notes_ai2_text" = "يتحول المربع والدائرة والمثلث الذي ترسمه بيدك إلى شكل منتظم. نرسم مربعًا.";
"tut_notes_ai2_text_v38" = "ارسم أضلاع الصندوق الأربعة بخطوط منفصلة: تستقيم الأضلاع وتتصل الزوايا. نرسم صندوقًا.";
"tut_notes_ai3" = "تصحيح الكل";
"tut_notes_ai3_text" = "عند رسم 3 عناصر أو أكثر معًا يظهر الاقتراح تلقائيًا. نرسم ثلاث حلقات متلامسة.";
"tut_notes_ai3_text_v38" = "نرسم ثلاث حلقات متلامسة: زر واحد يحوّل الثلاث إلى دوائر منتظمة.";
"tut_notes_ai_text" = "تحويل الكتابة اليدوية إلى نص وتصحيح الأشكال وتصحيح الكل.";
"tut_notes_ai_text_v38" = "تحويل خط اليد إلى نص (عنصران أو أكثر) وتصحيح الخطوط معًا.";
"tut_notes_f1" = "قائمة الإضافة";
"tut_notes_f1_text" = "في لوحة تدوين الملاحظات تُضاف الصيغ والمخططات أيضًا؛ اختر العنصر ثم المس اللوحة أو اسحب.";
"tut_notes_f2" = "الصيغة";
"tut_notes_f2_text" = "مئات الصيغ الجاهزة من الفيزياء والرياضيات والكيمياء؛ ويُعدَّل كل حرف ورقم على حدة. نضيف قانون نيوتن الثاني ومعادلة السرعة.";
"tut_notes_f3" = "المخطط";
"tut_notes_f3_text" = "تدفق وعملية وخريطة ذهنية وجدول زمني وغيرها؛ وتُعدَّل الخطوات فوق اللوحة. نلخّص الموضوع بمخطط انسيابي تحريري.";
"tut_notes_f4" = "الأسهم والأشكال";
"tut_notes_f4_text" = "اربط الملاحظات بالأسهم وجمّعها بالمربعات والإطارات. نرسم سهمًا من الصيغة إلى المخطط.";
"tut_notes_formula" = "الصيغ والمخططات والأشكال";
"tut_notes_formula_text" = "ملخص موضوع بصيغ جاهزة ومخطط انسيابي وأسهم.";
"tut_notes_w1" = "نص العنوان";
"tut_notes_w1_text" = "بـ«نص» من قائمة الإضافة تُكتب العناوين والنقاط والفقرات؛ والخط والحجم واللون من لوحة الفرشاة. نضع عنوانًا لملاحظة الدرس.";
"tut_notes_w2" = "أقلام الملاحظات";
"tut_notes_w2_text" = "قلم رصاص وجاف وحبر وجل وقلم لباد؛ حساسة للضغط وتتعرف على قلم الجهاز اللوحي. نكتب الملاحظات بالقلم الجاف.";
"tut_notes_w3" = "قلم التمييز";
"tut_notes_w3_text" = "ميّز المواضع المهمة: يبقى شفافًا فوق النص. نميّز العنوان.";
"tut_notes_w4" = "الصفحات وPDF";
"tut_notes_w4_text" = "من الشريط السفلي أضف صفحة أو انسخها أو احذفها أو انتقل بين الصفحات. ويمكنك حفظ ملاحظاتك بصيغة PDF من قائمة ⋮.";
"tut_notes_write" = "النص والأقلام";
"tut_notes_write_text" = "ملاحظة درس فيزياء بعنوان وأقلام ملاحظات وقلم تمييز وصفحات.";
