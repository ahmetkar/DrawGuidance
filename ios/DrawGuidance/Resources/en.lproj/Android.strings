"tut40_sn_diagram" = "Diagram";
"tut40_sn_diagram_text" = "Add a ready-made diagram with the diagram button. You can choose it with or without a background (transparent).";
"tut40_sn_pages" = "Pages";
"tut40_sn_pages_text" = "Add pages and switch between them with the bar at the bottom. Long-press the bar and slide to flip through pages quickly.";
"tut40_sn_pdf" = "Save as PDF";
