"tut40_art" = "New: ruler, template and moving";
"tut40_art_a5_text" = "Drag the selection or nudge it by 1–10 pixels with the arrow buttons; holding an element for 5 seconds also turns on Move. We lower the sun toward the space behind the mountains.";
"tut40_art_ai2_text" = "Draw several lines and lift the pen: each line becomes clean and nearby ends join up. We're drawing the moon with two arcs.";
"tut40_art_ai_text" = "Line fixing, template recognition (4+ elements close together), single-stroke suggestions and AI settings.";
"tut40_art_b3_text" = "First select the element you want to paint, then fill its inside with the paint bucket; with nothing selected it paints the paper. Solid color or gradient. We give the sky a sunset gradient.";
"tut40_art_text" = "Hold to move, moving the background, the ruler, shape templates and CMYK saving.";
"tut40_bg" = "Move the background";
"tut40_bg_text" = "After choosing a picture with the Background button, tap Move / resize: drag the picture, and resize it with two fingers or by its corners.";
"tut40_chars" = "Ready-made characters";
"tut40_chars_text" = "Add → Characters: choose a style and theme, then tap a character. Pick a variant from the Expressions, Poses, Action or Everyday groups and it is added to the page.";
"tut40_comic" = "New: characters and backgrounds";
"tut40_comic_ai_text" = "Comic-specific recognition (speech balloon, facial expressions), fixing lines together and single-stroke suggestions.";
"tut40_comic_bg" = "Location background";
"tut40_comic_bg_text" = "Add → Location background: Manga and Comic tabs with subcategories. Tap a background, then drop it on a panel and it fits that panel. Drop it outside the panels or tap Whole page to cover the page.";
"tut40_comic_export" = "PDF and CBZ";
"tut40_comic_export_text" = "Save your comic as a PDF or CBZ from the ⋮ menu. In a CBZ every page is a separate image and it opens in comic readers. You can also pick the folder while saving.";
"tut40_comic_p1_text" = "In Comic mode, templates, speech balloons, ready-made characters, effects and speed lines are in this menu.";
"tut40_comic_text" = "Ready-made characters and backgrounds, page numbers, PDF and CBZ, the ruler and hold to move.";
"tut40_diagram_bg" = "Diagrams with or without a background";
"tut40_diagram_bg_text" = "When adding a diagram, use the Background option to make its boxes filled or transparent; a transparent diagram doesn't hide the paper's lines. We add one of each.";
"tut40_hint_single" = "Single-stroke suggestion: tap it and the stroke becomes clean.";
"tut40_hold" = "Hold to move";
"tut40_hold_simple" = "Hold to move";
"tut40_hold_simple_text" = "To move something, hold your finger on it for 5 seconds. When the ring fills, drag.";
"tut40_hold_text" = "Keep your finger still on an element for 5 seconds: when the ring fills, the element is selected and Move turns on; drag without lifting your finger. It works in every drawing type.";
"tut40_kids_challenge" = "Drawing Quest";
"tut40_kids_challenge_text" = "The trophy button has the Drawing Quest: 50 whole levels! Draw a picture on each level and collect the stars.";
"tut40_kids_end_text" = "Finally, some green grass! Our picture is ready. If you want to see me again, tap my face in the corner. Now it's your turn!";
"tut40_kids_hi" = "I've got news!";
"tut40_kids_hi_text" = "Hello again! I'm going to show you some new things. Let's go!";
"tut40_kids_hold" = "Move a picture";
"tut40_kids_hold_text" = "To move a picture, hold your finger on it for 5 seconds. When the ring fills, slide your finger!";
"tut40_kids_new" = "What's new with Painty";
"tut40_kids_new_text" = "The ruler, moving pictures and the 50-level Drawing Quest.";
"tut40_kids_ruler" = "Ruler";
"tut40_kids_ruler_text" = "Tap the Ruler button: if you draw along the ruler's edge, your line comes out super straight! Press Finish when you're done.";
"tut40_notes" = "New: pages, ruler and PDF";
"tut40_notes_ai_text" = "Turning handwriting into text, fixing lines together and single-stroke suggestions.";
"tut40_notes_pdf" = "PDF and save location";
"tut40_notes_pdf_text" = "⋮ → Save as PDF: all pages in one file. You can pick a CMYK PDF for printing and set the folder with Choose location.";
"tut40_notes_text" = "The page scrubber, diagrams with or without a background, page numbers, header and footer, the ruler, PDF and the save location.";
"tut40_notes_w4_text" = "Add, duplicate and delete pages and switch between them with the bar at the bottom; long-press the bar to open the page scrubber. You can save your notes as a PDF from the ⋮ menu.";
"tut40_offer_title_simple_art" = "Welcome to simple drawing";
"tut40_offer_title_simple_notes" = "Welcome to simple notes";
"tut40_page_settings" = "Page numbers, header and footer";
"tut40_page_settings_text" = "⋮ → Page settings: add a number, a header and a footer to every page. They also appear in image, PDF and CBZ exports.";
"tut40_ruler" = "Ruler";
"tut40_ruler_bar" = "Type, unit and scale";
"tut40_ruler_bar_text" = "Use the buttons next to the ruler to pick its type: straight ruler, protractor, set square, compass, ellipse template or French curve. The button at the other end changes the unit (mm, cm, inch, pixel) and the scale (1:1, 1:2, 1:5…); Finish is there too.";
"tut40_ruler_draw" = "Draw along the edge";
"tut40_ruler_draw_text" = "Draw close to the ruler's edge: the line follows the edge and comes out perfectly straight. When you are done, tap Finish.";
"tut40_ruler_text" = "Tap the Ruler button in the Draw row. Rotate it with the handle at one end and lengthen it with the other; drag the body to move it. The angle and length are shown in the bar at the bottom.";
"tut40_sa_bg" = "Background";
"tut40_sa_bg_text" = "Choose the paper's color, pattern or picture. If you picked a picture, set its place and size with Move / resize.";
"tut40_sa_brush" = "Brush";
"tut40_sa_brush_text" = "Draw freely with the brush. You pick the color and thickness with the brush button.";
"tut40_sa_move" = "Select and Move";
"tut40_sa_move_text" = "The 5th button in the menu is Select and the 6th is Move. With Move, drag something to a new place. Shortcut: hold your finger on it for 5 seconds and drag when the ring fills.";
"tut40_sa_paint" = "Paint";
"tut40_sa_paint_text" = "Choose Paint, pick a color and tap inside a shape: that area gets painted.";
"tut40_sa_ruler" = "Ruler and shape template";
"tut40_sa_ruler_text" = "Tap the Ruler button. Draw along the ruler's edge for a perfectly straight line, then tap Finish. With the Shape template button, pick a shape and trace its edge to copy it.";
"tut40_sa_save" = "Save";
"tut40_sa_save_text" = "Save your picture. You can choose CMYK for printing and set the folder with Choose location.";
"tut40_sa_shape" = "Shapes";
"tut40_sa_shape_text" = "Add ready-made shapes with the shape button. We're putting in a house and a sun.";
"tut40_sa_text" = "Text box";
"tut40_sa_text_text" = "Write with the text button. While the text is selected, drag the handles on the box's edge to make the box bigger.";
"tut40_save" = "Save: CMYK and location";
"tut40_save_text" = "In the Save as image window you can pick the CMYK color mode for printing (TIFF or PDF). Use Choose location to set the file's folder; your choice is remembered.";
"tut40_scrubber" = "Page scrubber";
"tut40_scrubber_text" = "Long-press the page bar at the bottom: it grows larger; slide your finger left and right to fly through the pages, and the page opens when you let go.";
"tut40_simple_art" = "Get to know simple drawing";
"tut40_simple_art_text" = "Brush, shapes, paint, moving, text boxes, background, ruler and saving.";
"tut40_simple_notes" = "Get to know simple notes";
"tut40_simple_notes_text" = "Text, pen, diagrams, ruler, moving, pages and PDF.";
