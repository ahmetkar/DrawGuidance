"v46_template_blank" = "Blank";
"v46_template_blank_hint" = "Blank canvas: choose the size, paper and page count below.";
"v46_template_section" = "Template";
"v46_template_selected_hint" = "%1$@ The template's size, paper and pages are used; change anything and carry on.";
"v46_tut_addmenu" = "Tap an empty spot to add";
"v46_tut_addmenu_text" = "In Add mode, tapping an empty spot opens a vertical add menu right there: shape, text, formula, diagram… The item is added where you tapped.";
"v46_tut_art" = "What's new (v46)";
"v46_tut_art_text" = "The two-part top menu, the add menu on an empty spot and the selection menu at the corner of the selected item.";
"v46_tut_balloons" = "Balloons";
"v46_tut_balloons_text" = "A caption sets the scene; speech, shout, thought and whisper balloons give the characters a voice. Point the tail at the speaker.";
"v46_tut_chars" = "Characters";
"v46_tut_chars_text" = "Choose an expression, pose or action from Characters, then size and place it in the panel. Premium characters show a lock.";
"v46_tut_comic" = "What's new (v46)";
"v46_tut_comic_text" = "A real panel layout, ready locations and characters, balloons, effects; the cover and ready templates.";
"v46_tut_cover" = "Cover and ready templates";
"v46_tut_cover_text" = "A new comic starts with a cover page. When creating a canvas, pick a ready sample under Template (action, manga, webtoon, four-panel, dialogue) and carry on from it.";
"v46_tut_edit" = "Edit";
"v46_tut_edit_text" = "Edit opens actions for the item's type: edit shape, colour and fill, bring forward or send back, hide. Science shapes show their values here.";
"v46_tut_element" = "Element shapes";
"v46_tut_element_text" = "The periodic table cell and the Bohr atom model are drawn for the element you type: symbol (Na), name (sodium) or atomic number (11). Here sodium turns into chlorine.";
"v46_tut_formula" = "Formula and summary";
"v46_tut_formula_text" = "Add a ready formula under the diagram and write the topic's summary in the bottom strip. The page is ready for review.";
"v46_tut_fx" = "Speed lines and sound";
"v46_tut_fx_text" = "Speed lines show motion and sound effects show sound. Keeping the lines behind the character makes the scene easier to read.";
"v46_tut_kids_brush" = "Paint brush";
"v46_tut_kids_brush_text" = "Move your finger with Paint! If you start inside a shape, the paint stays inside.";
"v46_tut_notes" = "What's new (v46)";
"v46_tut_notes_text" = "A Cornell page with Add panels, and physics and element shapes that redraw when you type values.";
"v46_tut_panels" = "Add panels";
"v46_tut_panels_text" = "Split the page into framed areas: columns, grids, square areas or the Cornell layout (key questions, notes, summary). Each area is its own item.";
"v46_tut_param" = "Shape drawn from a formula";
"v46_tut_param_text" = "Free-body diagram, pulleys, lever and element shapes come with their formulas: forces, arrow lengths and results are calculated from the values.";
"v46_tut_places" = "Location background";
"v46_tut_places_text" = "Drop a ready location into a panel: the picture is cropped to the panel's shape and sits behind the panel border.";
"v46_tut_s_eyedrop" = "Eyedropper";
"v46_tut_s_eyedrop_text" = "Tap a colour in the picture with the eyedropper; the brush takes that colour.";
"v46_tut_s_select" = "Rectangle selection";
"v46_tut_s_select_text" = "Draw an area with rectangle selection in the top menu; everything inside is selected, then move or resize it.";
"v46_tut_s_shape" = "Shapes";
"v46_tut_s_shape_text" = "Pick a shape and drag: house, sun, star… Filled shapes quickly build the base of the picture.";
"v46_tut_scale" = "Scale and copy";
"v46_tut_scale_text" = "Scale makes the selection bigger or smaller; Copy places a copy next to it. Here the sun shrinks and the birds multiply.";
"v46_tut_selmenu" = "Selection menu";
"v46_tut_selmenu_text" = "When you select an item, a translucent menu appears at its corner: Move, Scale, Copy, Delete and Edit.";
"v46_tut_simple" = "What's new (v46)";
"v46_tut_simple_art_text" = "The two-part menu, rectangle selection and the eyedropper in the top menu.";
"v46_tut_simple_notes_text" = "Add panels, and science shapes that redraw when you type values.";
"v46_tut_split" = "Two-part top menu";
"v46_tut_split_text" = "Tools sit in two parts: stacked in portrait, side by side in landscape. When you switch mode (Draw, Add, Select…) both parts show that mode's tools.";
"v46_tut_titles" = "Title and questions";
"v46_tut_titles_text" = "Write the title in the notes area and the questions you'll ask yourself in the left column. When reviewing, cover the notes and look only at the questions.";
"v46_tut_tpl" = "Panel layout";
"v46_tut_tpl_text" = "Pick a layout from Templates: panels resize together, the gutter is adjustable and drawings inside move with their panel.";
"v46_tut_values" = "Type a value, the shape changes";
"v46_tut_values_text" = "Type a new value in the shape's formula field (e.g. F = 40, α = 30°) and the shape is redrawn; the corner formula and results update too.";
"v47_properties_empty" = "This tool has no settings. Settings appear here when the brush, eraser, pen or text tool is selected.";
"v48_tut_kids2_b" = "Drawing challenges are among the first tools. Adding 3D shapes was removed from kids mode.";
"v48_tut_kids2_t" = "Challenge";
"v48_tut_kids_b" = "The tools were reordered: Pen, Eraser, Paint, Shapes, Challenge, Stencil and Text come first.";
"v48_tut_kids_t" = "New order";
"v48_tut_modes_b" = "The mode menu is now Select, Draw, Add, Edit. Rotate, Scale and Crop live under Edit.";
"v48_tut_modes_t" = "Four modes";
"v48_tut_move_b" = "Move and Expand are two separate buttons under Edit. Move works when an element is selected, Expand when the canvas is selected.";
"v48_tut_move_t" = "Move and Expand";
"v48_tut_props_b" = "The old \"Brush settings\" is now \"Properties\": it shows the selected tool's settings. It fills in for the brush, eraser, pen or text tool.";
"v48_tut_props_t" = "Properties";
"v48_tut_summary" = "Meet the menus that changed in the latest version.";
"v48_tut_three_b" = "In simple mode on a portrait screen there are three menus: Add, Draw, Select & edit. Each menu is one row; if it doesn't fit it scrolls sideways.";
"v48_tut_three_t" = "Three menus";
