"tut_comic_p2_text" = "Tek dokunuşla hazır sayfa şablonları: iki şerit, dörtlü, manga, webtoon… Büyük bir üst panel ve iki küçük panel seçiyoruz.";
"tut_comic_p3" = "Mürekkep kalemi";
"tut_comic_p3_text" = "Çizgi roman hatları için mürekkep ve ince uçlu kalem; basınçla incelir. Kahramanımızı çiziyoruz.";
"tut_comic_p4" = "Hız ve odak çizgileri";
"tut_comic_p4_text" = "Hareket ve vurgu için hız, odak, patlama ve titreme çizgileri; seçili panelin içine yerleşir. Kahramanın çevresine odak çizgileri ekliyoruz.";
"tut_comic_panels" = "Paneller ve çizim";
"tut_comic_panels_text" = "Panel düzeni, mürekkep kalemiyle kahraman ve odak çizgileri.";
"tut_comic_t1" = "Konuşma balonu";
"tut_comic_t1_text" = "Oval, düşünce, bağırma, fısıltı ve anlatı balonları; kuyruğu sürükleyerek konuşana yönelt. Kahramanımız konuşuyor.";
"tut_comic_t2" = "Efekt yazısı";
"tut_comic_t2_text" = "BAM!, POW!, BOOM! gibi hazır, gradyanlı ve gölgeli yazılar. Bir efekt ekliyoruz.";
"tut_comic_t3" = "Anlatı kutusu";
"tut_comic_t3_text" = "Sahneyi anlatan sarı kutu; kuyruksuzdur. Hikâyeye giriş yapıyoruz.";
"tut_comic_text" = "Balon ve efekt yazısı";
"tut_comic_text_text" = "Konuşma balonu, efekt yazısı ve anlatı kutusu.";
"tut_done_badge" = "Tamamlandı";
"tut_drawing" = "Çiziliyor…";
"tut_finish" = "Eğitimi bitir";
"tut_finished" = "Eğitim tamamlandı: %@";
"tut_hint_all" = "Tümünü düzelt: her çizim kendi düzgün şekline döner (tek geri alma adımı).";
"tut_hint_lines" = "Çizgi önerisi: dokununca dikkate alınan bütün çizgiler birden düzelir (tek geri alma adımı).";
"tut_hint_shape" = "Öneri balonu: dokununca titrek çizgi kusursuz şekle dönüşür. İstersen sen dokun.";
"tut_hint_template" = "Şablon önerisi: dokununca çizimin yerine aynı fırçayla düzgün çizgiler gelir.";
"tut_hint_text" = "Yazı önerisi: dokununca el yazın aynı yerde ve renkte düzgün yazıya dönüşür.";
"tut_kids" = "Boyacık ile resim yapalım";
"tut_kids_1" = "Merhaba!";
"tut_kids_1_text" = "Ben Boyacık! Sana çizim araçlarını göstereceğim ve birlikte kocaman bir resim yapacağız. Hazır mısın?";
"tut_kids_2" = "Fırça";
"tut_kids_2_text" = "Fırçayla istediğin gibi çizersin. Bak, gökyüzüne parlak bir güneş çiziyorum!";
"tut_kids_3" = "Hazır resimler";
"tut_kids_3_text" = "Şekil düğmesinden hazır resimler eklersin. Bir ev ve renkli balonlar koyuyorum.";
"tut_kids_4" = "Boya kovası";
"tut_kids_4_text" = "Kovayı seç, bir renk seç ve şeklin içine dokun: dokunduğun yer boyanır. Çatı kırmızı, duvar sarı olsun!";
"tut_kids_5" = "Hepsini boya";
"tut_kids_5_text" = "Parmağını bir şeklin üstünde 2 saniye tut: halka dolunca bütün şekil birden boyanır. Balonların hepsi pembe!";
"tut_kids_6" = "Silgi";
"tut_kids_6_text" = "Silgiyle istemediğin çizgileri silersin. Şu karalamayı siliyorum.";
"tut_kids_7" = "Geri al";
"tut_kids_7_text" = "Bir şey yanlış mı oldu? Geri ok son yaptığını geri alır, ileri ok yeniden yapar.";
"tut_kids_8" = "Kâğıdın rengi";
"tut_kids_8_text" = "Kâğıdın rengini de değiştirebilirsin. Gökyüzü mavisi yapıyorum!";
"tut_kids_9" = "Bitti!";
"tut_kids_9_text" = "Son olarak yemyeşil çimen! İşte resmimiz hazır. Şimdi sıra sende, en güzel resmi sen yap!";
"tut_kids_text" = "Boyacık araçları tanıtır ve seninle adım adım bir resim yapar.";
"tut_lines_v38" = "Çizgileri düzelt";
"tut_menu" = "Eğitim modu";
"tut_next" = "Sonraki adım";
"tut_notes_ai" = "Yapay zekâ ile not";
"tut_notes_ai1" = "El yazısını yazıya çevir";
"tut_notes_ai1_text" = "Elle yazıp kalemi kaldır: Türkçe sözlük ve dil modeliyle tanınır, dokununca aynı yerde yazıya dönüşür. \"kuvvet\" yazıyoruz.";
"tut_notes_ai2" = "Şekil düzeltme";
"tut_notes_ai2_text" = "Elle çizdiğin kutu, çember ve üçgen düzgün şekle dönüşür. Bir kutu çiziyoruz.";
"tut_notes_ai2_text_v38" = "Kutunun dört kenarını ayrı çizgilerle çiz: kenarlar düzelir ve köşeler birleşir. Bir kutu çiziyoruz.";
"tut_notes_ai3" = "Tümünü düzelt";
"tut_notes_ai3_text" = "Bir arada çizilen 3 ve daha çok eleman için öneri kendiliğinden gelir. Birbirine değen üç halka çiziyoruz.";
"tut_notes_ai3_text_v38" = "Birbirine değen üç halka çiziyoruz: üçü de tek düğmeyle düzgün çembere döner.";
"tut_notes_ai_text" = "El yazısını yazıya çevirme, şekil düzeltme ve tümünü düzelt.";
"tut_notes_ai_text_v38" = "El yazısını yazıya çevirme (2+ eleman) ve çizgileri birlikte düzeltme.";
"tut_notes_f1" = "Ekle menüsü";
"tut_notes_f1_text" = "Not alma tuvalinde formül ve diyagram da eklenir; öğeyi seç, tuvale dokun ya da sürükle.";
"tut_notes_f2" = "Formül";
"tut_notes_f2_text" = "Fizik, matematik ve kimyadan yüzlerce hazır formül; her harf ve sayı ayrı düzenlenir. Newton'un ikinci yasasını ve hız denklemini ekliyoruz.";
"tut_notes_f3" = "Diyagram";
"tut_notes_f3_text" = "Akış, süreç, zihin haritası, zaman çizelgesi ve dahası; adımlar tuvalin üstünde düzenlenir. Konuyu editoryal bir akış diyagramıyla özetliyoruz.";
"tut_notes_f4" = "Ok ve şekiller";
"tut_notes_f4_text" = "Notları oklarla bağla, kutu ve çerçevelerle grupla. Formülden diyagrama bir ok çiziyoruz.";
"tut_notes_formula" = "Formül, diyagram ve şekil";
"tut_notes_formula_text" = "Hazır formüller, akış diyagramı ve oklarla konu özeti.";
"tut_notes_w1" = "Başlık yazısı";
"tut_notes_w1_text" = "Ekle menüsündeki Yazı ile başlık, madde ve paragraf yazılır; yazı tipi, boyut ve renk fırça panelinden. Ders notuna başlık koyuyoruz.";
"tut_notes_w2" = "Not kalemleri";
"tut_notes_w2_text" = "Kurşun, tükenmez, dolma, jel ve keçeli kalem; basınca duyarlı, tablet kalemini tanır. Tükenmez kalemle not alıyoruz.";
"tut_notes_w3" = "Fosforlu kalem";
"tut_notes_w3_text" = "Önemli yerleri vurgula: yazının üstünde saydam kalır. Başlığı işaretliyoruz.";
"tut_notes_w4" = "Sayfalar ve PDF";
"tut_notes_w4_text" = "Alttaki şeritten sayfa ekle, çoğalt, sil ve sayfalar arasında geç. Notlarını ⋮ menüsünden PDF olarak kaydedebilirsin.";
"tut_notes_write" = "Yazı ve kalemler";
"tut_notes_write_text" = "Başlık yazısı, not kalemleri, fosforlu kalem ve sayfalarla fizik ders notu.";
"tut_offer_later" = "Şimdi değil";
"tut_offer_note" = "Eğitim boş bir sayfada gösterilir; bitince ya da iptal edince tuvalin olduğu gibi kalır. İstediğin zaman ⋮ menüsündeki Eğitim modu ile yeniden açabilirsin.";
