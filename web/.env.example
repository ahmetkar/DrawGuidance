# Çizim Rehberi web sitesi ayarları. Yerelde bu dosyayı ".env.local" adıyla kopyalayın; Vercel'de
# Project Settings > Environment Variables bölümüne girin. NEXT_PUBLIC_* değerleri derleme anında koda gömülür
# (tarayıcıda görünür): buraya sır koymayın. Değiştirince yeniden dağıtın (Redeploy).

# Sunucu (Spring Boot) adresi; sonunda / olmadan
NEXT_PUBLIC_API_BASE_URL=https://drawapi.ahmetkar.com

# Firebase Console > Proje ayarları > Uygulamalarınız > Web uygulaması > SDK yapılandırması (proje: drawguidance).
# Dördünden biri boşsa "Google ile giriş yapıp sil" bölümü gizlenir, yalnız talep formu gösterilir.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=drawguidance.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=drawguidance
NEXT_PUBLIC_FIREBASE_APP_ID=

# İsteğe bağlı: sitenin üretim adresi (site haritası ve kanonik adresler; öntanımlı bu) ve herkese açık iletişim e-postası
NEXT_PUBLIC_SITE_URL=https://drawguidance.ahmetkar.com
NEXT_PUBLIC_CONTACT_EMAIL=ahmetkar.1258@gmail.com

# ---- v42 kurumsal site ve yönetim paneli (SUNUCU tarafı; NEXT_PUBLIC_ DEĞİL, tarayıcıya gitmez) ----
# Vercel → Storage → Neon Postgres oluşturup projeye bağlayınca DATABASE_URL kendiliğinden eklenir.
# Kurulum: DATABASE_URL=... npm run db:migrate
DATABASE_URL=
# İlk yönetici kurulumu için tek seferlik anahtar (en az 32 karakter; örn. `openssl rand -base64 48`).
# Kurulumdan sonra silebilirsiniz; yönetici varken kurulum sayfası zaten kapanır.
ADMIN_SETUP_TOKEN=
# IP adreslerinin özeti için tuz (en az 32 karakter rastgele). IP adresleri saklanmaz.
IP_HASH_SALT=
# İsteğe bağlı: passkey alan adı (öntanımlı NEXT_PUBLIC_SITE_URL'nin alan adı) ve ek izinli kökenler (virgülle)
ADMIN_RP_ID=
ADMIN_EXTRA_ORIGINS=
