# DrawGuidance yerel sunucu ayarları (v42, v43). Yerel-Sunucuyu-Baslat.bat ilk çalıştığında ".env" dosyasını bu
# örnekten rastgele parolalarla kendisi üretir; elle değiştirmek gerekmez.
MONGO_ROOT_USER=dgadmin
MONGO_ROOT_PASSWORD=
MONGO_APP_DB=drawguidance
MONGO_APP_USER=drawguidance
MONGO_APP_PASSWORD=
IP_HASH_SALT=
# Telefonun bağlanacağı kapı (uygulamada: http://<bu bilgisayarın IP'si>:4747)
API_PORT=4747
MONGO_PORT=27017
MONGO_CACHE_GB=1
FIREBASE_PROJECT_ID=drawguidance
# v43 cihaz bilgilerinin şifreleme anahtarı (ilk açılışta rastgele üretilir; değiştirirsen kayıtlı cihazlar okunamaz)
DEVICE_DATA_KEY=
# v43 paket resimlerinin Cloud Storage bucket'ı ve hizmet hesabı dosyası. Dosya, betik tarafından
# sirlar\gcs.json olarak kopyalanır (bulunamazsa paket resimleri verilemez, sunucu yine çalışır)
GCS_BUCKET=dgpackets
GCS_KEY_SOURCE=..\yayin-anahtari\gcs-service-account.json
